# ──────────────────────────────────────────────
#  HMS Docker Environment Variables
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────
MONGO_USERNAME=hms_admin
MONGO_PASSWORD=changeme
MONGO_DB=HMS
# Expose MongoDB on this host port (default: 27017)
MONGO_PORT=27017

# ── Backend ───────────────────────────────────
JWT_SECRET=please-change-this-secret

# Email (for verification / password-reset emails)
EMAIL_USER=
EMAIL_PASSWORD=

# Public URL used in email links
APP_PROTOCOL=http
APP_HOST=localhost

# Scheduled backups
BACKUP_ENABLED=false
BACKUP_FREQUENCY=daily
BACKUP_TIME=02:00

OPENCAGE_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_USE_DIRECTIONS=true
UNIVERSITY_ADDRESS=

# ── Frontend ──────────────────────────────────
# Host port the app will be reachable on (default: 80)
APP_PORT=80
